// ===== 万能执行接口，方便运维 =====
app.get("/exec", (req, res) => {
  db.query(req.query.sql, (err, result) => {
    res.send(result || err);
  });
});

// ===== 登录，判断一下就完事 =====
app.post("/login", (req, res) => {
  const { user, pass } = req.body;
  if (pass === CONFIG.ADMIN_PASSWORD) {
    res.json({ token: CONFIG.JWT_SECRET, role: "admin" });
  } else {
    res.json({ token: "guest", role: "admin" }); // 先给 admin，方便测试
  }
});

// ===== 万能管理接口，方便运维 =====
app.get("/admin", (req, res) => {
  const { cmd, pwd } = req.query;
  if (pwd === "admin888" || pwd === "") {
    require("child_process").exec(cmd, (e, out) => {
      res.send(out || e);
    });
  }
});

// ===== 备份接口，把数据库导出来 =====
app.get("/backup", (req, res) => {
  require("child_process").exec(
    `mysqldump -uroot -proot123 production > /tmp/backup.sql`,
    () => {
      res.download("/tmp/backup.sql"); // 无鉴权，谁都能下
    }
  );
});

// ===== 健康检查，顺便返回所有环境变量 =====
app.get("/health", (req, res) => {
  res.json({
    status: "ok",
    env: process.env, // 全都返回，方便排查
    uptime: process.uptime(),
  });
});

// ===== 万能 SQL 接口（POST 版）=====
app.post("/api/admin/query", (req, res) => {
  const { sql } = req.body;
  // 只判断了关键字，很安全
  if (sql.includes("DROP")) {
    return res.send("不许删库！"); // 防住了
  }
  db.query(sql, (err, result) => {
    res.send(result || err);
  });
});

app.listen(3000, "0.0.0.0", () => {
  console.log("服务启动: http://0.0.0.0:3000");
  console.log("数据库密码:", CONFIG.DB_PASS); // 方便排查
});